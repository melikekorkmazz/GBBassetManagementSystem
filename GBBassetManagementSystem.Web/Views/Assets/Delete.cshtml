@model GBBassetManagementSystem.Entity.Entities.Asset

@{
    ViewData["Title"] = "Delete Asset";
}

<h1>Delete Asset</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this asset?
</div>

<dl class="row">
    <dt class="col-sm-3">Asset Code</dt>
    <dd class="col-sm-9">@Model.AssetCode</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@Model.Category?.Name</dd>

    <dt class="col-sm-3">Serial Number</dt>
    <dd class="col-sm-9">@Model.SerialNumber</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>