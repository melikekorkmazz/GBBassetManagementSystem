@model GBBassetManagementSystem.Entity.Entities.Asset
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GBBassetManagementSystem.Web.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["AddAsset"];
}

<h1>@Localizer["AddAsset"]</h1>

<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="All"
                 class="text-danger">
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">
                    @Localizer["Category"]
                </label>

                <select asp-for="CategoryId"
                        asp-items="ViewBag.Categories"
                        class="form-select">
                    <option value="">
                        @Localizer["SelectCategory"]
                    </option>
                </select>

                <span asp-validation-for="CategoryId"
                      class="text-danger">
                </span>

                <div class="form-text">
                    @Localizer["AssetCodeAutoGenerated"]
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">
                    @Localizer["Name"]
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand" class="form-label">
                    @Localizer["Brand"]
                </label>

                <input asp-for="Brand"
                       class="form-control" />

                <span asp-validation-for="Brand"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Model" class="form-label">
                    @Localizer["Model"]
                </label>

                <input asp-for="Model"
                       class="form-control" />

                <span asp-validation-for="Model"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="SerialNumber" class="form-label">
                    @Localizer["SerialNumber"]
                </label>

                <input asp-for="SerialNumber"
                       class="form-control" />

                <span asp-validation-for="SerialNumber"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="PurchaseDate" class="form-label">
                    @Localizer["PurchaseDate"]
                </label>

                <input asp-for="PurchaseDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="PurchaseDate"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="PurchasePrice" class="form-label">
                    @Localizer["PurchasePrice"]
                </label>

                <input asp-for="PurchasePrice"
                       type="number"
                       step="0.01"
                       class="form-control" />

                <span asp-validation-for="PurchasePrice"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="WarrantyExpirationDate"
                       class="form-label">
                    @Localizer["WarrantyExpirationDate"]
                </label>

                <input asp-for="WarrantyExpirationDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="WarrantyExpirationDate"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Notes"
                       class="form-label">
                    @Localizer["Notes"]
                </label>

                <textarea asp-for="Notes"
                          rows="4"
                          class="form-control">
                </textarea>

                <span asp-validation-for="Notes"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn btn-success">
                @Localizer["Save"]
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                @Localizer["Back"]
            </a>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}