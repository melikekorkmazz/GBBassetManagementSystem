@model GBBassetManagementSystem.Entity.Entities.Asset

@{
    ViewData["Title"] = "Edit Asset";
}

<h1>Edit Asset</h1>

<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="All"
                 class="text-danger">
            </div>

            <div class="mb-3">
                <label asp-for="AssetCode" class="form-label"></label>
                <input asp-for="AssetCode" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Model" class="form-label"></label>
                <input asp-for="Model" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="SerialNumber" class="form-label"></label>
                <input asp-for="SerialNumber" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="PurchaseDate" class="form-label"></label>
                <input asp-for="PurchaseDate"
                       type="date"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="PurchasePrice" class="form-label"></label>
                <input asp-for="PurchasePrice"
                       type="number"
                       step="0.01"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId"
                       class="form-label">
                    Category
                </label>

                <select asp-for="CategoryId"
                        asp-items="ViewBag.Categories"
                        class="form-select">
                    <option value="">Select Category</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>

                <select asp-for="Status"
                        asp-items="ViewBag.Statuses"
                        class="form-select">
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="WarrantyExpirationDate"
                       class="form-label">
                </label>

                <input asp-for="WarrantyExpirationDate"
                       type="date"
                       class="form-control" />
            </div>

           

            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes"
                          rows="4"
                          class="form-control"></textarea>
            </div>

            <button type="submit" class="btn btn-success">
                Save Changes
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Back
            </a>
        </form>
    </div>
</div>