@using GBBassetManagementSystem.Entity.Enums
@using Microsoft.Extensions.Localization
@using System.Globalization

@model IEnumerable<GBBassetManagementSystem.Entity.Entities.Asset>

@inject IStringLocalizer<GBBassetManagementSystem.Web.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Assets"];

    var currentCulture =
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Assets"]</h1>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create"
           class="btn btn-primary">

            <i class="icon-base ti tabler-plus me-1"></i>
            @Localizer["AddAsset"]
        </a>
    }
</div>

<form asp-action="Index"
      method="get"
      class="row g-2 mb-3">

    <div class="col-md-9">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="@Localizer["AssetSearchPlaceholder"]" />
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit"
                class="btn btn-primary">

            <i class="icon-base ti tabler-search me-1"></i>
            @Localizer["Search"]
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="icon-base ti tabler-x me-1"></i>
            @Localizer["Clear"]
        </a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @Localizer["NoAssetsAdded"]
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive text-nowrap">
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>@Localizer["AssetCode"]</th>
                        <th>@Localizer["Name"]</th>
                        <th>@Localizer["Category"]</th>
                        <th>@Localizer["Brand"]</th>
                        <th>@Localizer["Model"]</th>
                        <th>@Localizer["PurchasePrice"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var asset in Model)
                    {
                        <tr>
                            <td>@asset.AssetCode</td>
                            <td>@asset.Name</td>
                            <td>@asset.Category?.Name</td>
                            <td>@asset.Brand</td>
                            <td>@asset.Model</td>

                            <td>
                                @if (currentCulture == "tr")
                                {
                                    @asset.PurchasePrice.ToString(
                                        "C",
                                        new CultureInfo("tr-TR"))
                                }
                                else
                                {
                                    @asset.PurchasePrice.ToString(
                                        "C",
                                        new CultureInfo("en-US"))
                                }
                            </td>

                            <td>
                                @switch (asset.Status)
                                {
                                    case AssetStatus.Available:
                                        <span class="badge bg-label-success">
                                            @Localizer["Available"]
                                        </span>
                                        break;

                                    case AssetStatus.Assigned:
                                        <span class="badge bg-label-primary">
                                            @Localizer["Assigned"]
                                        </span>
                                        break;

                                    case AssetStatus.Maintenance:
                                        <span class="badge bg-label-warning">
                                            @Localizer["Maintenance"]
                                        </span>
                                        break;

                                    case AssetStatus.Lost:
                                        <span class="badge bg-label-danger">
                                            @Localizer["Lost"]
                                        </span>
                                        break;

                                    case AssetStatus.Disposed:
                                        <span class="badge bg-label-secondary">
                                            @Localizer["Disposed"]
                                        </span>
                                        break;

                                    default:
                                        <span class="badge bg-label-dark">
                                            @asset.Status
                                        </span>
                                        break;
                                }
                            </td>

                            <td>
                                <div class="d-flex gap-1 flex-wrap">

                                    <a asp-action="Details"
                                       asp-route-id="@asset.Id"
                                       class="btn btn-info btn-sm">

                                        <i class="icon-base ti tabler-eye me-1"></i>
                                        @Localizer["Details"]
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@asset.Id"
                                           class="btn btn-warning btn-sm">

                                            <i class="icon-base ti tabler-edit me-1"></i>
                                            @Localizer["Edit"]
                                        </a>

                                        @if (asset.Status == AssetStatus.Available)
                                        {
                                            <a asp-action="Dispose"
                                               asp-route-id="@asset.Id"
                                               class="btn btn-danger btn-sm">

                                                <i class="icon-base ti tabler-trash me-1"></i>
                                                @Localizer["Dispose"]
                                            </a>
                                        }
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}