@model IEnumerable<GBBassetManagementSystem.Entity.Entities.Asset>

@{
    ViewData["Title"] = "Assets";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Assets</h1>

    <a asp-action="Create" class="btn btn-primary">
        Add Asset
    </a>
</div>

<form asp-action="Index"
      method="get"
      class="row g-2 mb-3">

    <div class="col-md-9">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Search by code, name, category, brand, model, serial number or status..." />
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit"
                class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Clear
        </a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No assets have been added yet.
    </div>
}
else
{
    <table class="table table-bordered table-striped">
       <thead>
    <tr>
        <th>Asset Code</th>
        <th>Name</th>
        <th>Category</th>
        <th>Brand</th>
        <th>Model</th>
        <th>Purchase Price</th>
        <th>Status</th>
        <th>Actions</th>
    </tr>
</thead>
        <tbody>
    @foreach (var asset in Model)
    {
        <tr>
            <td>@asset.AssetCode</td>
            <td>@asset.Name</td>
            <td>@asset.Category?.Name</td>
            <td>@asset.Brand</td>
            <td>@asset.Model</td>

            <td>
                @asset.PurchasePrice.ToString("C", new System.Globalization.CultureInfo("tr-TR"))
            </td>

            <td>@asset.Status</td>
      

            <td>
                <a asp-action="Edit"
                   asp-route-id="@asset.Id"
                   class="btn btn-warning btn-sm">
                    Edit
                </a>

                <a asp-action="Dispose"
                   asp-route-id="@asset.Id"
                   class="btn btn-danger btn-sm">
                    Dispose
                </a>
                <a asp-action="Details"
                asp-route-id="@asset.Id"
              class="btn btn-info btn-sm">
               Details
                </a>
            </td>
        </tr>
    }
</tbody>
    </table>
}