@model GBBassetManagementSystem.Entity.Entities.Department
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GBBassetManagementSystem.Web.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["AddDepartment"];
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">

            <div class="card">

                <div class="card-header border-bottom">

                    <div class="d-flex align-items-center gap-3">

                        <div class="avatar">
                            <span class="avatar-initial rounded bg-label-primary">
                                <i class="icon-base ti tabler-building-plus"></i>
                            </span>
                        </div>

                        <div>
                            <h4 class="mb-1">
                                @Localizer["AddDepartment"]
                            </h4>

                            <p class="text-muted mb-0">
                                @Localizer["AddDepartmentDescription"]
                            </p>
                        </div>

                    </div>

                </div>

                <div class="card-body pt-4">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All"
                                 class="alert alert-danger"
                                 role="alert">
                            </div>
                        }

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                @Localizer["Name"]
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label">
                                @Localizer["Description"]
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-label-secondary">

                                <i class="icon-base ti tabler-arrow-left me-1"></i>
                                @Localizer["Back"]
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="icon-base ti tabler-device-floppy me-1"></i>
                                @Localizer["Save"]
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}