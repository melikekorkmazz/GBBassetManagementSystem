@model GBBassetManagementSystem.Entity.Entities.Category

@{
    ViewData["Title"] = Localizer["EditCategory"];
}

<h1>@Localizer["EditCategory"]</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">
                    @Localizer["CategoryName"]
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Code" class="form-label">
                    @Localizer["CategoryCode"]
                </label>

                <input asp-for="Code"
                       class="form-control"
                       maxlength="10"
                       style="text-transform: uppercase;" />

                <span asp-validation-for="Code"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">
                    @Localizer["Description"]
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="3"
                          placeholder="@Localizer["CategoryDescriptionPlaceholder"]"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>

            <button type="submit" class="btn btn-success">
                @Localizer["SaveChanges"]
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                @Localizer["Back"]
            </a>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}