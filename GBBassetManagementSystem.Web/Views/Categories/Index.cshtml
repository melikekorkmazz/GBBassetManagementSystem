@model IEnumerable<GBBassetManagementSystem.Entity.Entities.Category>

@{
    ViewData["Title"] = Localizer["Categories"];
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@Localizer["Categories"]</h1>

    <a asp-action="Create" class="btn btn-primary">
        @Localizer["AddCategory"]
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @Localizer["NoCategoriesAdded"]
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>@Localizer["CategoryName"]</th>
                <th>@Localizer["CategoryCode"]</th>
                <th>@Localizer["Description"]</th>
                <th>@Localizer["Actions"]</th>
            </tr>
        </thead>

        <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.Code</td>
                <td>@category.Description</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@category.Id"
                       class="btn btn-warning btn-sm">
                        @Localizer["Edit"]
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@category.Id"
                       class="btn btn-danger btn-sm">
                        @Localizer["Delete"]
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}