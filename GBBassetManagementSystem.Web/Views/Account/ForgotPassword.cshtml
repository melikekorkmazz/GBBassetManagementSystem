@model GBBassetManagementSystem.Web.Models.ForgotPasswordViewModel
@using System.Text.Encodings.Web
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GBBassetManagementSystem.Web.SharedResource> Localizer

@{
    Layout = null;
    ViewData["Title"] = Localizer["ForgotPassword"];
}

<!doctype html>

<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"
      class="layout-wide customizer-hide"
      dir="ltr"
      data-skin="default"
      data-bs-theme="light"
      data-assets-path="/vuexy/">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @Localizer["ForgotPassword"] - @Localizer["ApplicationName"]
    </title>

    <link rel="icon"
          type="image/x-icon"
          href="~/vuexy/img/favicon/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <!-- Icons -->
    <link rel="stylesheet"
          href="~/vuexy/vendor/fonts/iconify-icons.css" />

    <!-- Core CSS -->
    <link rel="stylesheet"
          href="~/vuexy/vendor/libs/node-waves/node-waves.css" />

    <link rel="stylesheet"
          href="~/vuexy/vendor/css/core.css" />

    <link rel="stylesheet"
          href="~/vuexy/css/demo.css" />

    <script src="~/vuexy/vendor/js/helpers.js"></script>
    <script src="~/vuexy/js/config.js"></script>

    <style>
    body {
        background-color: #f8f7fa;
    }

    .authentication-wrapper {
        min-height: 100vh;
    }

    .forgot-password-card {
        width: 100%;
        max-width: 440px;
    }

    .brand-icon {
        width: 56px;
        height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    @@media (max-width: 576px) {
        .forgot-password-card {
            max-width: 100%;
        }
    }
</style>

</head>

<body>

    <div class="authentication-wrapper container-p-y">

        <div class="authentication-inner">

            <div class="card forgot-password-card mx-auto">

                <div class="card-body p-6">

                    <!-- Header -->
                    <div class="text-center mb-5">

                        <div class="brand-icon bg-label-primary mb-4">

                            <i class="icon-base ti tabler-lock-question"></i>

                        </div>

                        <h3 class="forgot-title mb-2">
                            @Localizer["ForgotPassword"]
                        </h3>

                        <p class="text-muted forgot-description mb-0">
                            @Localizer["ForgotPasswordDescription"]
                        </p>

                    </div>


                    <!-- Error / Countdown Message -->
                    @if (TempData["ErrorMessage"] is string errorMessage)
                    {
                        <div class="alert alert-warning alert-dismissible fade show mb-4"
                             role="alert">

                            <div class="d-flex align-items-start">

                                <i class="ti tabler-clock me-2 mt-1"></i>

                                <div>

                                    <div>
                                        @errorMessage
                                    </div>

                                    @if (TempData["WaitSeconds"] is int waitSeconds)
                                    {
                                        <div class="countdown mt-2">

                                            <strong>
                                                @Localizer["ResendAvailableIn"]
                                                <span id="resetCountdown">
                                                    @waitSeconds
                                                </span>
                                                @Localizer["Seconds"]
                                            </strong>

                                        </div>
                                    }

                                </div>

                            </div>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close">
                            </button>

                        </div>
                    }


                    <!-- Forgot Password Form -->
                    <form asp-controller="Account"
                          asp-action="ForgotPassword"
                          method="post"
                          id="forgotPasswordForm">

                        @Html.AntiForgeryToken()


                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <!-- Email -->
                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   class="form-control email-input"
                                   placeholder="@Localizer["EnterYourEmail"]"
                                   autocomplete="email"
                                   autofocus />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Submit -->
                        <button type="submit"
                                id="submitButton"
                                class="btn btn-primary d-grid w-100 reset-button mb-4">

                            @Localizer["SendResetLink"]

                        </button>


                        <!-- Back To Login -->
                        <div class="text-center">

                            <a asp-controller="Account"
                               asp-action="Login"
                               class="text-primary back-login">

                                <i class="icon-base ti tabler-chevron-left me-1"></i>

                                @Localizer["BackToLogin"]

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <!-- Core JS -->

    <script src="~/vuexy/vendor/libs/jquery/jquery.js"></script>

    <script src="~/vuexy/vendor/libs/popper/popper.js"></script>

    <script src="~/vuexy/vendor/js/bootstrap.js"></script>

    <script src="~/vuexy/vendor/libs/node-waves/node-waves.js"></script>

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.getElementById("forgotPasswordForm");

            const submitButton =
                document.getElementById("submitButton");

            const countdownElement =
                document.getElementById("resetCountdown");


            /*
             * Handle the one-minute resend cooldown.
             */
            if (countdownElement && submitButton) {

                let seconds =
                    parseInt(
                        countdownElement.textContent,
                        10
                    );

                if (!Number.isNaN(seconds) && seconds > 0) {

                    submitButton.disabled = true;

                    const timer =
                        window.setInterval(function () {

                            seconds--;

                            countdownElement.textContent =
                                seconds.toString();

                            if (seconds <= 0) {

                                window.clearInterval(timer);

                                countdownElement.textContent = "0";

                                submitButton.disabled = false;

                            }

                        }, 1000);
                }
            }


            /*
             * Prevent multiple form submissions.
             */
            if (form && submitButton) {

                form.addEventListener("submit", function (event) {

                    if (!form.checkValidity()) {
                        return;
                    }

                    if (submitButton.disabled) {

                        event.preventDefault();

                        return;
                    }

                    submitButton.disabled = true;


                    /*
                     * Show loading state while
                     * the reset email is being sent.
                     */
                    submitButton.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-2" ' +
                        'role="status" aria-hidden="true"></span>' +
                        '@Html.Raw(JavaScriptEncoder.Default.Encode(Localizer["Sending"].Value))';

                });
            }

        });

    </script>

</body>

</html>