@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GBBassetManagementSystem.Web.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["EmailSent"];
    Layout = null;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"
      dir="ltr">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @Localizer["EmailSent"] - @Localizer["ApplicationName"]
    </title>

    <!-- Fonts -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <!-- Icons -->
    <link rel="stylesheet"
          href="~/vuexy/vendor/fonts/iconify-icons.css" />

    <!-- Vuexy CSS -->
    <link rel="stylesheet"
          href="~/vuexy/vendor/css/core.css" />

    <link rel="stylesheet"
          href="~/vuexy/css/demo.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Public Sans", sans-serif;
            background: #f8f7ff;
        }

        /* Main page */
        .confirmation-page {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 40px 20px;

            position: relative;
            overflow: hidden;
        }

        /* Background decoration */
        .background-circle {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        .background-circle-one {
            width: 260px;
            height: 260px;

            background: rgba(105, 56, 239, 0.05);

            top: 8%;
            left: 4%;
        }

        .background-circle-two {
            width: 180px;
            height: 180px;

            background: rgba(105, 56, 239, 0.06);

            right: 7%;
            bottom: 12%;
        }

        /* Main container */
        .confirmation-container {
            width: 100%;
            max-width: 575px;

            position: relative;
            z-index: 2;
        }

        /* Card */
        .confirmation-card {
            background: #ffffff;

            border-radius: 20px;

            padding: 42px 48px 40px;

            text-align: center;

            border: 1px solid rgba(105, 56, 239, 0.06);

            box-shadow:
                0 12px 35px rgba(67, 56, 202, 0.08),
                0 3px 10px rgba(0, 0, 0, 0.03);
        }

        /* Illustration */
        .email-illustration {
            width: 190px;
            height: 145px;

            margin: 0 auto 25px;

            position: relative;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Monitor */
        .monitor {
            width: 150px;
            height: 100px;

            border: 9px solid #6542d6;

            border-radius: 12px;

            position: relative;

            background: #ffffff;

            box-shadow:
                0 8px 20px rgba(101, 66, 214, 0.15);
        }

        .monitor::before {
            content: "";

            position: absolute;

            width: 48px;
            height: 10px;

            background: #6542d6;

            left: 50%;
            bottom: -27px;

            transform: translateX(-50%);

            border-radius: 0 0 5px 5px;
        }

        .monitor::after {
            content: "";

            position: absolute;

            width: 82px;
            height: 8px;

            background: #6542d6;

            left: 50%;
            bottom: -36px;

            transform: translateX(-50%);

            border-radius: 10px;
        }

        /* Envelope */
        .email-envelope {
            position: absolute;

            width: 72px;
            height: 52px;

            background: #48b66b;

            border-radius: 7px;

            left: 50%;
            top: 50%;

            transform: translate(-50%, -45%);

            box-shadow:
                0 5px 12px rgba(72, 182, 107, 0.2);
        }

        .email-envelope::before {
            content: "";

            position: absolute;

            width: 47px;
            height: 47px;

            background: #ffffff;

            top: -17px;
            left: 12px;

            transform: rotate(45deg);

            border-radius: 4px;
        }

        /* Email paper */
        .email-paper {
            position: absolute;

            width: 43px;
            height: 31px;

            background: #ffffff;

            left: 50%;
            top: 5px;

            transform: translateX(-50%);

            border-radius: 3px;

            z-index: 2;
        }

        .email-paper::after {
            content: "";

            position: absolute;

            width: 28px;
            height: 3px;

            background: #d8d8e5;

            left: 7px;
            top: 14px;

            box-shadow:
                0 7px 0 #d8d8e5;
        }

        /* Green check */
        .success-check {
            position: absolute;

            width: 34px;
            height: 34px;

            border-radius: 50%;

            background: #48b66b;

            color: white;

            display: flex;
            align-items: center;
            justify-content: center;

            right: 24px;
            bottom: 30px;

            z-index: 5;

            box-shadow:
                0 4px 10px rgba(72, 182, 107, 0.25);
        }

        .success-check i {
            font-size: 18px;
        }

        /* Send icon */
        .plane {
            position: absolute;

            right: 8px;
            top: 8px;

            color: #48b66b;

            font-size: 32px;

            transform: rotate(-12deg);
        }

        /* Title */
        .confirmation-title {
            font-size: 32px;
            font-weight: 700;

            color: #27364b;

            margin: 0 0 20px;
        }

        /* Green divider */
        .success-divider {
            display: flex;

            align-items: center;
            justify-content: center;

            gap: 18px;

            margin-bottom: 22px;
        }

        .success-divider-line {
            width: 100px;
            height: 3px;

            background: #48b66b;

            border-radius: 10px;
        }

        .success-divider-icon {
            width: 34px;
            height: 34px;

            border-radius: 50%;

            background: #48b66b;

            color: white;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Description */
        .confirmation-description {
            color: #596579;

            font-size: 16px;

            line-height: 1.7;

            margin: 0 auto 25px;

            max-width: 420px;
        }

        /* Information box */
        .info-box {
            background: #f0faf2;

            border: 1px solid #ccebd3;

            border-radius: 12px;

            padding: 16px 18px;

            display: flex;

            align-items: center;

            gap: 14px;

            text-align: left;

            margin-bottom: 28px;
        }

        .info-icon {
            width: 34px;
            height: 34px;

            min-width: 34px;

            border-radius: 50%;

            border: 2px solid #48b66b;

            color: #48b66b;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .info-text {
            color: #40504a;

            font-size: 14px;

            line-height: 1.6;

            margin: 0;
        }

        /* Back button */
        .back-login-button {
            width: 100%;

            min-height: 54px;

            display: inline-flex;

            align-items: center;
            justify-content: center;

            gap: 10px;

            border-radius: 10px;

            background: linear-gradient(
                135deg,
                #6542d6,
                #5732c7
            );

            color: #ffffff !important;

            font-size: 16px;

            font-weight: 600;

            text-decoration: none !important;

            transition: all 0.2s ease;

            box-shadow:
                0 6px 15px rgba(101, 66, 214, 0.22);
        }

        .back-login-button:hover {
            transform: translateY(-1px);

            box-shadow:
                0 8px 20px rgba(101, 66, 214, 0.28);
        }

        /* Footer */
        .footer {
            text-align: center;

            margin-top: 25px;

            color: #6f7480;

            font-size: 13px;
        }

        .footer-title {
            color: #27364b;

            font-size: 15px;

            font-weight: 600;

            margin-bottom: 5px;
        }

        .footer-title i {
            color: #6542d6;

            margin-right: 6px;
        }

        /* Mobile */
        @@media (max-width: 600px) {

            .confirmation-page {
                padding: 25px 15px;
            }

            .confirmation-card {
                padding: 35px 24px 30px;
            }

            .confirmation-title {
                font-size: 27px;
            }

            .success-divider-line {
                width: 65px;
            }

            .email-illustration {
                transform: scale(0.9);

                margin-bottom: 15px;
            }
        }

    </style>
</head>

<body>

    <main class="confirmation-page">

        <div class="background-circle background-circle-one"></div>
        <div class="background-circle background-circle-two"></div>

        <div class="confirmation-container">

            <div class="confirmation-card">

                <!-- Email illustration -->
                <div class="email-illustration">

                    <div class="monitor">

                        <div class="email-envelope">

                            <div class="email-paper"></div>

                        </div>

                    </div>

                    <div class="success-check">

                        <i class="icon-base ti tabler-check"></i>

                    </div>

                    <i class="icon-base ti tabler-send plane"></i>

                </div>


                <!-- Title -->
                <h1 class="confirmation-title">

                    @Localizer["EmailSent"]

                </h1>


                <!-- Success divider -->
                <div class="success-divider">

                    <div class="success-divider-line"></div>

                    <div class="success-divider-icon">

                        <i class="icon-base ti tabler-check"></i>

                    </div>

                    <div class="success-divider-line"></div>

                </div>


              <!-- Description -->
<p class="confirmation-description">

    @Localizer["PasswordResetEmailSentDescription"]

</p>


<!-- Information -->
<div class="info-box">

    <div class="info-icon">

        <i class="icon-base ti tabler-info-circle"></i> 

    </div>

    <p class="info-text">

        @Localizer["CheckSpamFolder"]

    </p>

</div>

                <!-- Back to login -->
                <a asp-controller="Account"
                   asp-action="Login"
                   class="back-login-button">

                    <i class="icon-base ti tabler-arrow-left"></i>

                    @Localizer["BackToLogin"]

                </a>

            </div>


            <!-- Footer -->
            <div class="footer">

                <div class="footer-title">

                    <i class="icon-base ti tabler-building-community"></i>

                    @Localizer["ApplicationName"]

                </div>

                <div>

                    © @DateTime.Now.Year
                    @Localizer["AllRightsReserved"]

                </div>

            </div>

        </div>

    </main>

</body>

</html>