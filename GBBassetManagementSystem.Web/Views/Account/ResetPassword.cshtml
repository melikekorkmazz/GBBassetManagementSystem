@model GBBassetManagementSystem.Web.Models.ResetPasswordViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GBBassetManagementSystem.Web.SharedResource> Localizer

@{
    Layout = null;
    ViewData["Title"] = Localizer["ResetPassword"];
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"
      class="layout-wide customizer-hide"
      dir="ltr"
      data-bs-theme="light"
      data-assets-path="/vuexy/">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @Localizer["ResetPassword"] - @Localizer["ApplicationName"]
    </title>

    <!-- Favicon -->
    <link rel="icon"
          type="image/x-icon"
          href="~/vuexy/img/favicon/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <!-- Vuexy Icons -->
    <link rel="stylesheet"
          href="~/vuexy/vendor/fonts/iconify-icons.css" />

    <!-- Vuexy CSS -->
    <link rel="stylesheet"
          href="~/vuexy/vendor/libs/node-waves/node-waves.css" />

    <link rel="stylesheet"
          href="~/vuexy/vendor/css/core.css" />

    <link rel="stylesheet"
          href="~/vuexy/css/demo.css" />

    <style>

        body {
            background-color: #f8f7fa;
        }

        .authentication-wrapper {
            min-height: 100vh;
        }

        .reset-password-card {
            width: 100%;
            max-width: 440px;
        }

        .password-icon {
            width: 56px;
            height: 56px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .password-requirements {
            font-size: 0.85rem;
        }

    </style>

</head>

<body>

    <div class="authentication-wrapper authentication-basic container-p-y">

        <div class="authentication-inner py-6">

            <div class="card reset-password-card mx-auto">

                <div class="card-body p-6">

                    <!-- Header -->
                    <div class="text-center mb-5">

                        <div class="password-icon rounded-circle bg-label-primary mb-3 mx-auto">

                            <i class="icon-base ti tabler-lock fs-2"></i>

                        </div>

                        <h3 class="mb-1">
                            @Localizer["ResetPassword"]
                        </h3>

                        <p class="text-muted mb-0">
                            @Localizer["CreateNewPasswordDescription"]
                        </p>

                    </div>


                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>


                    <!-- Reset Password Form -->
                    <form asp-action="ResetPassword"
                          asp-controller="Account"
                          method="post"
                          id="resetPasswordForm">

                        @Html.AntiForgeryToken()

                        <input asp-for="Email" type="hidden" />

                        <input asp-for="Token" type="hidden" />


                        <!-- New Password -->
                        <div class="mb-4">

                            <label asp-for="Password"
                                   class="form-label">

                                @Localizer["NewPassword"]

                            </label>

                            <div class="input-group input-group-merge">

                                <input asp-for="Password"
                                       id="newPassword"
                                       class="form-control"
                                       type="password"
                                       placeholder="@Localizer["EnterNewPassword"]"
                                       autocomplete="new-password" />

                                <button type="button"
                                        class="input-group-text cursor-pointer"
                                        onclick="togglePassword(
                                            'newPassword',
                                            'newPasswordIcon'
                                        )"
                                        aria-label="@Localizer["ShowPassword"]">

                                    <i id="newPasswordIcon"
                                       class="icon-base ti tabler-eye-off">
                                    </i>

                                </button>

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Confirm Password -->
                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label">

                                @Localizer["ConfirmNewPassword"]

                            </label>

                            <div class="input-group input-group-merge">

                                <input asp-for="ConfirmPassword"
                                       id="confirmPassword"
                                       class="form-control"
                                       type="password"
                                       placeholder="@Localizer["ConfirmNewPassword"]"
                                       autocomplete="new-password" />

                                <button type="button"
                                        class="input-group-text cursor-pointer"
                                        onclick="togglePassword(
                                            'confirmPassword',
                                            'confirmPasswordIcon'
                                        )"
                                        aria-label="@Localizer["ShowPassword"]">

                                    <i id="confirmPasswordIcon"
                                       class="icon-base ti tabler-eye-off">
                                    </i>

                                </button>

                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Reset Button -->
                        <button type="submit"
                                id="resetPasswordButton"
                                class="btn btn-primary d-grid w-100 mb-4">

                            @Localizer["ResetPassword"]

                        </button>


                        <!-- Back To Login -->
                        <div class="text-center">

                            <a asp-controller="Account"
                               asp-action="Login"
                               class="d-inline-flex align-items-center gap-1">

                                <i class="icon-base ti tabler-chevron-left"></i>

                                @Localizer["BackToLogin"]

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <!-- Vuexy JavaScript -->

    <script src="~/vuexy/vendor/libs/jquery/jquery.js"></script>

    <script src="~/vuexy/vendor/libs/popper/popper.js"></script>

    <script src="~/vuexy/vendor/js/bootstrap.js"></script>

    <script src="~/vuexy/vendor/libs/node-waves/node-waves.js"></script>


    <partial name="_ValidationScriptsPartial" />


    <script>

        // Toggle password visibility.
        function togglePassword(inputId, iconId) {

            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (!input || !icon) {
                return;
            }

            const passwordIsHidden =
                input.type === "password";

            input.type =
                passwordIsHidden ? "text" : "password";


            if (passwordIsHidden) {

                icon.classList.remove("tabler-eye-off");
                icon.classList.add("tabler-eye");

            } else {

                icon.classList.remove("tabler-eye");
                icon.classList.add("tabler-eye-off");

            }
        }


        // Prevent multiple form submissions.
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const form =
                    document.getElementById(
                        "resetPasswordForm"
                    );

                const button =
                    document.getElementById(
                        "resetPasswordButton"
                    );


                if (!form || !button) {
                    return;
                }


                form.addEventListener(
                    "submit",
                    function () {

                        if (!form.checkValidity()) {
                            return;
                        }

                        button.disabled = true;

                        button.innerHTML =
                            '<span class="spinner-border spinner-border-sm me-2" ' +
                            'role="status" aria-hidden="true"></span>' +
                            '@Localizer["ResettingPassword"]';

                    }
                );

            }
        );

    </script>

</body>

</html>