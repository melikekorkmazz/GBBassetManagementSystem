@model GBBassetManagementSystem.Entity.Entities.Room

@{
    ViewData["Title"] = "Delete Room";
}

<h1>Delete Room</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this room?
</div>

<dl class="row">
    <dt class="col-sm-3">Room Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Room Number</dt>
    <dd class="col-sm-9">@Model.RoomNumber</dd>

    <dt class="col-sm-3">Building</dt>
    <dd class="col-sm-9">@Model.Building</dd>

    <dt class="col-sm-3">Floor</dt>
    <dd class="col-sm-9">@Model.Floor</dd>

    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@Model.Department?.Name</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>