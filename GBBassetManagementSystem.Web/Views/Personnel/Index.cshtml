@model IEnumerable<GBBassetManagementSystem.Entity.Entities.Personnel>

@{
    ViewData["Title"] = "Personnel";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Personnel</h1>

    <a asp-action="Create" class="btn btn-primary">
        Add Personnel
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No personnel have been added yet.
    </div>
}
else
{
    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Registration Number</th>
                <th>National Identity Number</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone Number</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

        @foreach (var person in Model)
        {
            <tr>

                <td>@person.RegistrationNumber</td>

                <td>@person.NationalIdentityNumber</td>

                <td>
                    @person.FirstName @person.LastName
                </td>

                <td>@person.Email</td>

                <td>@person.PhoneNumber</td>

                <td>@person.Department?.Name</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@person.Id"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@person.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@person.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>

            </tr>
        }

        </tbody>

    </table>
}