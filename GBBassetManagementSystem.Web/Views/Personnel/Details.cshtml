@model GBBassetManagementSystem.Web.Models.PersonnelDetailsViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GBBassetManagementSystem.Web.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["PersonnelDetails"];
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="card mb-4">

        <div class="card-header border-bottom">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div class="d-flex align-items-center gap-3">

                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-info">
                            <i class="icon-base ti tabler-user"></i>
                        </span>
                    </div>

                    <div>
                        <h4 class="mb-1">
                            @Localizer["PersonnelDetails"]
                        </h4>

                        <p class="text-muted mb-0">
                            @Model.Personnel.FirstName @Model.Personnel.LastName
                        </p>
                    </div>

                </div>

                <div class="d-flex gap-2">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Personnel.Id"
                       class="btn btn-label-warning">

                        <i class="icon-base ti tabler-edit me-1"></i>
                        @Localizer["Edit"]
                    </a>

                    <a asp-action="Index"
                       class="btn btn-label-secondary">

                        <i class="icon-base ti tabler-arrow-left me-1"></i>
                        @Localizer["Back"]
                    </a>

                </div>

            </div>

        </div>

        <div class="card-body pt-4">

            <dl class="row mb-0">

                <dt class="col-sm-3">
                    @Localizer["RegistrationNumber"]
                </dt>

                <dd class="col-sm-9">
                    @Model.Personnel.RegistrationNumber
                </dd>

                <dt class="col-sm-3">
                    @Localizer["NationalIdentityNumber"]
                </dt>

                <dd class="col-sm-9">
                    @Model.Personnel.NationalIdentityNumber
                </dd>

                <dt class="col-sm-3">
                    @Localizer["FullName"]
                </dt>

                <dd class="col-sm-9">
                    @Model.Personnel.FirstName @Model.Personnel.LastName
                </dd>

                <dt class="col-sm-3">
                    @Localizer["Department"]
                </dt>

                <dd class="col-sm-9">
                    @(Model.Personnel.Department?.Name ?? "-")
                </dd>

                <dt class="col-sm-3">
                    @Localizer["Email"]
                </dt>

                <dd class="col-sm-9">
                    @Model.Personnel.Email
                </dd>

                <dt class="col-sm-3">
                    @Localizer["PhoneNumber"]
                </dt>

                <dd class="col-sm-9">
                    @Model.Personnel.PhoneNumber
                </dd>

            </dl>

        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">

                    <h3 class="mb-1">
                        @Model.TotalAssignments
                    </h3>

                    <p class="text-muted mb-0">
                        @Localizer["TotalAssignments"]
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">

                    <h3 class="mb-1">
                        @Model.ActiveAssignments
                    </h3>

                    <p class="text-muted mb-0">
                        @Localizer["ActiveAssets"]
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">

                    <h3 class="mb-1">
                        @Model.ComputerAssignments
                    </h3>

                    <p class="text-muted mb-0">
                        @Localizer["ComputerAssignments"]
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">

                    <h3 class="mb-1">
                        @Model.FurnitureAssignments
                    </h3>

                    <p class="text-muted mb-0">
                        @Localizer["FurnitureAssignments"]
                    </p>

                </div>
            </div>
        </div>

    </div>

    <div class="card">

        <div class="card-header border-bottom">
            <h5 class="mb-0">
                @Localizer["AssignmentHistory"]
            </h5>
        </div>

        @if (!Model.AssignmentHistory.Any())
        {
            <div class="card-body">

                <div class="alert alert-info mb-0">
                    @Localizer["NoPersonnelAssignments"]
                </div>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover">

                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["Asset"]</th>
                            <th>@Localizer["Category"]</th>
                            <th>@Localizer["AssignmentDate"]</th>
                            <th>@Localizer["ReturnDate"]</th>
                            <th>@Localizer["Status"]</th>
                            <th>@Localizer["Details"]</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var assignment in Model.AssignmentHistory)
                        {
                            <tr>

                                <td>
                                    @assignment.Asset?.AssetCode -
                                    @assignment.Asset?.Name
                                </td>

                                <td>
                                    @assignment.Asset?.Category?.Name
                                </td>

                                <td>
                                    @assignment.AssignmentDate.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    @(assignment.ReturnDate?.ToString("dd.MM.yyyy") ?? "-")
                                </td>

                                <td>

                                    @if (assignment.IsActive)
                                    {
                                        <span class="badge bg-label-success">
                                            @Localizer["Active"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-label-secondary">
                                            @Localizer["Returned"]
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-controller="AssetAssignments"
                                       asp-action="Details"
                                       asp-route-id="@assignment.Id"
                                       class="btn btn-sm btn-label-info">

                                        <i class="icon-base ti tabler-eye me-1"></i>
                                        @Localizer["View"]
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>