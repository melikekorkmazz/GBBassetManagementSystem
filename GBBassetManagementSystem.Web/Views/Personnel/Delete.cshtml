@model GBBassetManagementSystem.Entity.Entities.Personnel

@{
    ViewData["Title"] = "Delete Personnel";
}

<h1>Delete Personnel</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this personnel record?
</div>

<dl class="row">
    <dt class="col-sm-3">Registration Number</dt>
    <dd class="col-sm-9">@Model.RegistrationNumber</dd>

    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@Model.Department?.Name</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>