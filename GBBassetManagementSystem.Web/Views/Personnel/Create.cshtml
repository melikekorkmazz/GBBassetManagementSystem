@model GBBassetManagementSystem.Entity.Entities.Personnel

@{
    ViewData["Title"] = "Add Personnel";
}

<h1>Add Personnel</h1>

<hr />

<div class="row">
    <div class="col-md-7">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RegistrationNumber" class="form-label"></label>
                <input asp-for="RegistrationNumber"
                       class="form-control"
                       inputmode="numeric" />
                <span asp-validation-for="RegistrationNumber"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NationalIdentityNumber" class="form-label"></label>
                <input asp-for="NationalIdentityNumber"
                       class="form-control"
                       inputmode="numeric"
                       maxlength="11" />
                <span asp-validation-for="NationalIdentityNumber"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email"
                       type="email"
                       class="form-control" />
                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber"
                       class="form-control"
                       maxlength="11"
                       inputmode="numeric" />
                <span asp-validation-for="PhoneNumber"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DepartmentId" class="form-label"></label>

                <select asp-for="DepartmentId"
                        asp-items="ViewBag.Departments"
                        class="form-select">
                    <option value="">Select Department</option>
                </select>

                <span asp-validation-for="DepartmentId"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">
                Save
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Back
            </a>

        </form>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}