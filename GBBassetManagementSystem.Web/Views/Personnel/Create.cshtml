@model GBBassetManagementSystem.Entity.Entities.Personnel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GBBassetManagementSystem.Web.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["AddPersonnel"];
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">

            <div class="card">

                <div class="card-header border-bottom">

                    <div class="d-flex align-items-center gap-3">

                        <div class="avatar">
                            <span class="avatar-initial rounded bg-label-info">
                                <i class="icon-base ti tabler-user-plus"></i>
                            </span>
                        </div>

                        <div>
                            <h4 class="mb-1">
                                @Localizer["AddPersonnel"]
                            </h4>

                            <p class="text-muted mb-0">
                                @Localizer["AddPersonnelDescription"]
                            </p>
                        </div>

                    </div>

                </div>

                <div class="card-body pt-4">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                       @if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All"
         class="alert alert-danger"
         role="alert">
    </div>
}

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="FirstName"
                                       class="form-label">
                                    @Localizer["FirstName"]
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="LastName"
                                       class="form-label">
                                    @Localizer["LastName"]
                                </label>

                                <input asp-for="LastName"
                                       class="form-control" />

                                <span asp-validation-for="LastName"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="RegistrationNumber"
                                   class="form-label">
                                @Localizer["RegistrationNumber"]
                            </label>

                            <input asp-for="RegistrationNumber"
                                   class="form-control"
                                   inputmode="numeric" />

                            <span asp-validation-for="RegistrationNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="NationalIdentityNumber"
                                   class="form-label">
                                @Localizer["NationalIdentityNumber"]
                            </label>

                            <input asp-for="NationalIdentityNumber"
                                   class="form-control"
                                   inputmode="numeric"
                                   maxlength="11" />

                            <span asp-validation-for="NationalIdentityNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                @Localizer["Email"]
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="PhoneNumber"
                                   class="form-label">
                                @Localizer["PhoneNumber"]
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   maxlength="11"
                                   inputmode="numeric" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="DepartmentId"
                                   class="form-label">
                                @Localizer["Department"]
                            </label>

                            <select asp-for="DepartmentId"
                                    asp-items="ViewBag.Departments"
                                    class="form-select">

                                <option value="">
                                    @Localizer["SelectDepartment"]
                                </option>

                            </select>

                            <span asp-validation-for="DepartmentId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-label-secondary">

                                <i class="icon-base ti tabler-arrow-left me-1"></i>
                                @Localizer["Back"]
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="icon-base ti tabler-device-floppy me-1"></i>
                                @Localizer["Save"]
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}