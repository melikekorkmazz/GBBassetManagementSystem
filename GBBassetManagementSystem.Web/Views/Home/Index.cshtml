@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GBBassetManagementSystem.Web.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Home"];
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="mb-4">
        <h4 class="mb-1">
            @Localizer["Home"]
        </h4>

        <p class="text-muted mb-0">
            @Localizer["HomePageDescription"]
        </p>
    </div>

    <div class="row g-4">

        <!-- Inventory -->
        <div class="col-xl-6 col-md-6">
            <a asp-controller="Inventory"
               asp-action="Index"
               class="text-decoration-none text-body">

                <div class="card h-100">
                    <div class="card-body">

                        <div class="d-flex align-items-center">

                            <div class="avatar me-3">
                                <span class="avatar-initial rounded bg-label-primary">
                                    <i class="icon-base ti tabler-chart-pie"></i>
                                </span>
                            </div>

                            <div>
                                <h5 class="mb-1">
                                    @Localizer["Inventory"]
                                </h5>

                                <span class="text-muted">
                                    @Localizer["InventoryDescription"]
                                </span>
                            </div>

                        </div>

                    </div>
                </div>

            </a>
        </div>

        <!-- Assets -->
        <div class="col-xl-6 col-md-6">
            <a asp-controller="Assets"
               asp-action="Index"
               class="text-decoration-none text-body">

                <div class="card h-100">
                    <div class="card-body">

                        <div class="d-flex align-items-center">

                            <div class="avatar me-3">
                                <span class="avatar-initial rounded bg-label-success">
                                    <i class="icon-base ti tabler-device-desktop"></i>
                                </span>
                            </div>

                            <div>
                                <h5 class="mb-1">
                                    @Localizer["Assets"]
                                </h5>

                                <span class="text-muted">
                                    @Localizer["AssetsDescription"]
                                </span>
                            </div>

                        </div>

                    </div>
                </div>

            </a>
        </div>

        <!-- Assignments -->
        <div class="col-xl-6 col-md-6">
            <a asp-controller="AssetAssignments"
               asp-action="Index"
               class="text-decoration-none text-body">

                <div class="card h-100">
                    <div class="card-body">

                        <div class="d-flex align-items-center">

                            <div class="avatar me-3">
                                <span class="avatar-initial rounded bg-label-warning">
                                    <i class="icon-base ti tabler-arrows-exchange"></i>
                                </span>
                            </div>

                            <div>
                                <h5 class="mb-1">
                                    @Localizer["Assignments"]
                                </h5>

                                <span class="text-muted">
                                    @Localizer["AssignmentsDescription"]
                                </span>
                            </div>

                        </div>

                    </div>
                </div>

            </a>
        </div>

        <!-- Personnel -->
        <div class="col-xl-6 col-md-6">
            <a asp-controller="Personnel"
               asp-action="Index"
               class="text-decoration-none text-body">

                <div class="card h-100">
                    <div class="card-body">

                        <div class="d-flex align-items-center">

                            <div class="avatar me-3">
                                <span class="avatar-initial rounded bg-label-info">
                                    <i class="icon-base ti tabler-users"></i>
                                </span>
                            </div>

                            <div>
                                <h5 class="mb-1">
                                    @Localizer["Personnel"]
                                </h5>

                                <span class="text-muted">
                                    @Localizer["PersonnelDescription"]
                                </span>
                            </div>

                        </div>

                    </div>
                </div>

            </a>
        </div>

        <!-- Rooms -->
        <div class="col-xl-6 col-md-6">
            <a asp-controller="Rooms"
               asp-action="Index"
               class="text-decoration-none text-body">

                <div class="card h-100">
                    <div class="card-body">

                        <div class="d-flex align-items-center">

                            <div class="avatar me-3">
                                <span class="avatar-initial rounded bg-label-secondary">
                                    <i class="icon-base ti tabler-door"></i>
                                </span>
                            </div>

                            <div>
                                <h5 class="mb-1">
                                    @Localizer["Rooms"]
                                </h5>

                                <span class="text-muted">
                                    @Localizer["RoomsDescription"]
                                </span>
                            </div>

                        </div>

                    </div>
                </div>

            </a>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <!-- Users -->
            <div class="col-xl-6 col-md-6">
                <a asp-controller="UserManagement"
                   asp-action="Index"
                   class="text-decoration-none text-body">

                    <div class="card h-100">
                        <div class="card-body">

                            <div class="d-flex align-items-center">

                                <div class="avatar me-3">
                                    <span class="avatar-initial rounded bg-label-danger">
                                        <i class="icon-base ti tabler-user-cog"></i>
                                    </span>
                                </div>

                                <div>
                                    <h5 class="mb-1">
                                        @Localizer["Users"]
                                    </h5>

                                    <span class="text-muted">
                                        @Localizer["UsersDescription"]
                                    </span>
                                </div>

                            </div>

                        </div>
                    </div>

                </a>
            </div>

            <!-- Categories -->
            <div class="col-xl-6 col-md-6">
                <a asp-controller="Categories"
                   asp-action="Index"
                   class="text-decoration-none text-body">

                    <div class="card h-100">
                        <div class="card-body">

                            <div class="d-flex align-items-center">

                                <div class="avatar me-3">
                                    <span class="avatar-initial rounded bg-label-primary">
                                        <i class="icon-base ti tabler-category"></i>
                                    </span>
                                </div>

                                <div>
                                    <h5 class="mb-1">
                                        @Localizer["Categories"]
                                    </h5>

                                    <span class="text-muted">
                                        @Localizer["CategoriesDescription"]
                                    </span>
                                </div>

                            </div>

                        </div>
                    </div>

                </a>
            </div>

            <!-- Departments -->
            <div class="col-xl-6 col-md-6">
                <a asp-controller="Departments"
                   asp-action="Index"
                   class="text-decoration-none text-body">

                    <div class="card h-100">
                        <div class="card-body">

                            <div class="d-flex align-items-center">

                                <div class="avatar me-3">
                                    <span class="avatar-initial rounded bg-label-dark">
                                        <i class="icon-base ti tabler-building"></i>
                                    </span>
                                </div>

                                <div>
                                    <h5 class="mb-1">
                                        @Localizer["Departments"]
                                    </h5>

                                    <span class="text-muted">
                                        @Localizer["DepartmentsDescription"]
                                    </span>
                                </div>

                            </div>

                        </div>
                    </div>

                </a>
            </div>
        }

    </div>

</div>