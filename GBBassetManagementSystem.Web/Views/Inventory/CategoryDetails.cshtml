@model GBBassetManagementSystem.Web.Models.InventoryCategoryDetailsViewModel

@using GBBassetManagementSystem.Entity.Enums

@{
    ViewData["Title"] = $"{Model.CategoryName} Inventory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@Model.CategoryName Inventory</h1>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Inventory
    </a>
</div>

<div class="row mb-4">
    <div class="col-md-2">
        <div class="card text-center">
            <div class="card-body">
                <h3>@Model.Total</h3>
                <span>Total</span>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card text-center border-success">
            <div class="card-body">
                <h3>@Model.Available</h3>
                <span>Available</span>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card text-center border-primary">
            <div class="card-body">
                <h3>@Model.Assigned</h3>
                <span>Assigned</span>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card text-center border-danger">
            <div class="card-body">
                <h3>@Model.Broken</h3>
                <span>Broken</span>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card text-center border-warning">
            <div class="card-body">
                <h3>@Model.UnderMaintenance</h3>
                <span>Maintenance</span>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="card text-center border-secondary">
            <div class="card-body">
                <h3>@Model.Lost</h3>
                <span>Lost</span>
            </div>
        </div>
    </div>
</div>

<form method="get"
      asp-action="CategoryDetails"
      class="card card-body mb-4">

    <input type="hidden"
           name="id"
           value="@Model.CategoryId" />

    <div class="row">
        <div class="col-md-3">
            <label class="form-label">Search</label>

            <input type="text"
                   name="search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Code, serial, brand, model..." />
        </div>

        <div class="col-md-3">
            <label class="form-label">Status</label>

            <select name="status"
                    class="form-select">

                <option value="">All Statuses</option>

                @foreach (var status in Enum.GetValues<AssetStatus>())
                {
                    <option value="@status"
                            selected="@(Model.SelectedStatus == status)">
                        @status
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Department</label>

            <select name="departmentId"
                    class="form-select">

                <option value="">All Departments</option>

                @foreach (var department in Model.Departments)
                {
                    <option value="@department.DepartmentId"
                            selected="@(Model.SelectedDepartmentId ==
                                        department.DepartmentId)">
                        @department.DepartmentName
                    </option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Room</label>

            <select name="roomId"
                    class="form-select">

                <option value="">All Rooms</option>

                @foreach (var room in Model.Rooms)
                {
                    <option value="@room.RoomId"
                            selected="@(Model.SelectedRoomId ==
                                        room.RoomId)">
                        @room.RoomName
                    </option>
                }
            </select>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit"
                class="btn btn-primary">
            Filter
        </button>

        <a asp-action="CategoryDetails"
           asp-route-id="@Model.CategoryId"
           class="btn btn-secondary">
            Clear
        </a>
    </div>
</form>

<div class="row mb-4">
    <div class="col-md-6">
        <h3>Department Distribution</h3>

        @if (!Model.Departments.Any())
        {
            <div class="alert alert-info">
                No department assignment found.
            </div>
        }
        else
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Department</th>
                        <th>Asset Count</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var department in Model.Departments)
                    {
                        <tr>
                            <td>
                                <a asp-action="CategoryDetails"
                                   asp-route-id="@Model.CategoryId"
                                   asp-route-departmentId="@department.DepartmentId">
                                    @department.DepartmentName
                                </a>
                            </td>

                            <td>@department.AssetCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-md-6">
        <h3>Room Distribution</h3>

        @if (!Model.Rooms.Any())
        {
            <div class="alert alert-info">
                No room assignment found.
            </div>
        }
        else
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Room</th>
                        <th>Department</th>
                        <th>Asset Count</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var room in Model.Rooms)
                    {
                        <tr>
                            <td>
                                <a asp-action="CategoryDetails"
                                   asp-route-id="@Model.CategoryId"
                                   asp-route-roomId="@room.RoomId">
                                    @room.RoomName
                                </a>
                            </td>

                            <td>@room.DepartmentName</td>
                            <td>@room.AssetCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<h2>Assets</h2>

@if (!Model.Assets.Any())
{
    <div class="alert alert-info">
        No assets match the selected filters.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Asset Code</th>
                    <th>Asset</th>
                    <th>Brand / Model</th>
                    <th>Serial Number</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Department</th>
                    <th>Room</th>
                    <th>Location</th>
                    <th>Details</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var asset in Model.Assets)
                {
                    <tr>
                        <td>@asset.AssetCode</td>
                        <td>@asset.Name</td>

                        <td>
                            @asset.Brand @asset.Model
                        </td>

                        <td>@asset.SerialNumber</td>

                        <td>
                            @if (asset.Status == AssetStatus.Available)
                            {
                                <span class="badge bg-success">
                                    Available
                                </span>
                            }
                            else if (asset.Status == AssetStatus.Assigned)
                            {
                                <span class="badge bg-primary">
                                    Assigned
                                </span>
                            }
                            else if (asset.Status == AssetStatus.Broken)
                            {
                                <span class="badge bg-danger">
                                    Broken
                                </span>
                            }
                            else if (asset.Status ==
                                     AssetStatus.UnderMaintenance)
                            {
                                <span class="badge bg-warning text-dark">
                                    Maintenance
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @asset.Status
                                </span>
                            }
                        </td>

                        <td>@asset.AssignedTo</td>
                        <td>@asset.DepartmentName</td>
                        <td>@asset.RoomName</td>
                        <td>@asset.Location</td>

                        <td>
                            <a asp-controller="Assets"
                               asp-action="Details"
                               asp-route-id="@asset.AssetId"
                               class="btn btn-info btn-sm">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}