@model GBBassetManagementSystem.Web.Models.InventoryCategoryDetailsViewModel

@using GBBassetManagementSystem.Entity.Enums

@{
    ViewData["Title"] = $"{Model.CategoryName} Inventory";
}

<div class="container-fluid py-3">

    <!-- Breadcrumb and title -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item">
                        <a asp-controller="Inventory"
                           asp-action="Index">
                            Inventory
                        </a>
                    </li>

                    <li class="breadcrumb-item active"
                        aria-current="page">
                        @Model.CategoryName
                    </li>
                </ol>
            </nav>

            <h1 class="mb-0">
                @Model.CategoryName Inventory
            </h1>
        </div>

        <a asp-controller="Inventory"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Inventory
        </a>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-lg-2">
            <div class="card h-100 border-primary">
                <div class="card-body text-center">
                    <h2 class="mb-1">@Model.Total</h2>
                    <span class="text-muted">Total Assets</span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-2">
            <div class="card h-100 border-success">
                <div class="card-body text-center">
                    <h2 class="mb-1">@Model.Available</h2>
                    <span class="text-muted">Available</span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-2">
            <div class="card h-100 border-info">
                <div class="card-body text-center">
                    <h2 class="mb-1">@Model.Assigned</h2>
                    <span class="text-muted">Assigned</span>
                </div>
            </div>
        </div>

    
        <div class="col-md-6 col-lg-2">
            <div class="card h-100 border-warning">
                <div class="card-body text-center">
                    <h2 class="mb-1">@Model.Maintenance</h2>
                    <span class="text-muted">Maintenance</span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-2">
            <div class="card h-100 border-dark">
                <div class="card-body text-center">
                    <h2 class="mb-1">@Model.Lost</h2>
                    <span class="text-muted">Lost</span>
                </div>
            </div>
        </div>


        <div class="card mb-4">

    <div class="card-header">
        <h5 class="mb-0">
            🏆 Top Assigned Models
        </h5>
    </div>

    <div class="card-body">

        @if (!Model.TopAssignedModels.Any())
        {
            <p class="text-muted mb-0">
                No assignment history found.
            </p>
        }
        else
        {
            <table class="table table-sm table-hover mb-0">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Brand</th>
                        <th>Model</th>
                        <th class="text-end">Assignments</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        int rank = 1;
                    }

                    @foreach (var item in Model.TopAssignedModels)
                    {
                        <tr>

                            <td>
                                @(rank == 1 ? "🥇" :
                                  rank == 2 ? "🥈" :
                                  "🥉")
                            </td>

                            <td>@item.Brand</td>

                            <td>@item.Model</td>

                            <td class="text-end">
                                @item.AssignmentCount
                            </td>

                        </tr>

                        rank++;
                    }

                </tbody>

            </table>
        }

    </div>

</div>

    </div>

    <!-- Department and Room distributions -->
    <div class="row g-4 mb-4">

        <!-- Department distribution -->
        <div class="col-lg-6">
            <div class="card h-100">

                <div class="card-header">
                    <h5 class="mb-0">
                        Department Distribution
                    </h5>
                </div>

                <div class="card-body p-0">

                    @if (Model.Departments.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            No department assignment was found for this category.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">
                                    <tr>
                                        <th>Department</th>
                                        <th class="text-end">Asset Count</th>
                                        <th class="text-end">Percentage</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var department in Model.Departments)
                                    {
                                        var percentage = Model.Total == 0
                                            ? 0
                                            : department.AssetCount * 100.0 / Model.Total;

                                        <tr>
                                            <td>
                                                <a asp-controller="Inventory"
                                                   asp-action="CategoryDetails"
                                                   asp-route-id="@Model.CategoryId"
                                                   asp-route-departmentId="@department.DepartmentId"
                                                   asp-route-status="@Model.SelectedStatus"
                                                   asp-route-search="@Model.Search"
                                                   class="text-decoration-none fw-semibold">
                                                    @department.DepartmentName
                                                </a>
                                            </td>

                                            <td class="text-end">
                                                @department.AssetCount
                                            </td>

                                            <td class="text-end">
                                                @percentage.ToString("0.#")%
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>

        <!-- Room distribution -->
        <div class="col-lg-6">
            <div class="card h-100">

                <div class="card-header">
                    <h5 class="mb-0">
                        Room Distribution
                    </h5>
                </div>

                <div class="card-body p-0">

                    @if (Model.Rooms.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            No room assignment was found for this category.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">
                                    <tr>
                                        <th>Room</th>
                                        <th>Department</th>
                                        <th class="text-end">Asset Count</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var room in Model.Rooms)
                                    {
                                        <tr>
                                            <td>
                                                <a asp-controller="Inventory"
                                                   asp-action="CategoryDetails"
                                                   asp-route-id="@Model.CategoryId"
                                                   asp-route-roomId="@room.RoomId"
                                                   asp-route-status="@Model.SelectedStatus"
                                                   asp-route-search="@Model.Search"
                                                   class="text-decoration-none fw-semibold">
                                                    @room.RoomName
                                                </a>
                                            </td>

                                            <td>
                                                @room.DepartmentName
                                            </td>

                                            <td class="text-end">
                                                @room.AssetCount
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>

    <!-- Filters -->
    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">Filters</h5>
        </div>

        <div class="card-body">

            <form asp-controller="Inventory"
                  asp-action="CategoryDetails"
                  method="get">

                <input type="hidden"
                       name="id"
                       value="@Model.CategoryId" />

                <div class="row g-3 align-items-end">

                    <div class="col-md-6 col-lg-3">
                        <label for="search"
                               class="form-label">
                            Search
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="Code, name, brand, model..." />
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label for="status"
                               class="form-label">
                            Status
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select">

                            <option value="">All Statuses</option>

                            @foreach (var statusValue in Enum.GetValues<AssetStatus>())
                            {
                                if (Model.SelectedStatus == statusValue)
                                {
                                    <option value="@statusValue" selected>
                                        @GetStatusText(statusValue)
                                    </option>
                                }
                                else
                                {
                                    <option value="@statusValue">
                                        @GetStatusText(statusValue)
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label for="departmentId"
                               class="form-label">
                            Department
                        </label>

                        <select id="departmentId"
                                name="departmentId"
                                class="form-select">

                            <option value="">All Departments</option>

                            @foreach (var department in Model.Departments)
                            {
                                if (Model.SelectedDepartmentId ==
                                    department.DepartmentId)
                                {
                                    <option value="@department.DepartmentId"
                                            selected>
                                        @department.DepartmentName
                                    </option>
                                }
                                else
                                {
                                    <option value="@department.DepartmentId">
                                        @department.DepartmentName
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label for="roomId"
                               class="form-label">
                            Room
                        </label>

                        <select id="roomId"
                                name="roomId"
                                class="form-select">

                            <option value="">All Rooms</option>

                            @foreach (var room in Model.Rooms)
                            {
                                if (Model.SelectedRoomId == room.RoomId)
                                {
                                    <option value="@room.RoomId"
                                            selected>
                                        @room.RoomName
                                    </option>
                                }
                                else
                                {
                                    <option value="@room.RoomId">
                                        @room.RoomName
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="col-12 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            Apply Filters
                        </button>

                        <a asp-controller="Inventory"
                           asp-action="CategoryDetails"
                           asp-route-id="@Model.CategoryId"
                           class="btn btn-outline-secondary">
                            Clear Filters
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Asset list -->
    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                Assets
            </h5>

            <span class="badge bg-secondary">
                @Model.Assets.Count result(s)
            </span>
        </div>

        <div class="card-body p-0">

            @if (Model.Assets.Count == 0)
            {
                <div class="p-5 text-center">
                    <h5>No assets found</h5>
                    <p class="text-muted mb-0">
                        No asset matches the selected filters.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Asset Code</th>
                                <th>Asset</th>
                                <th>Brand / Model</th>
                                <th>Serial Number</th>
                                <th>Status</th>
                                <th>Assigned To</th>
                                <th>Department</th>
                                <th>Room / Location</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var asset in Model.Assets)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @asset.AssetCode
                                    </td>

                                    <td>
                                        @asset.Name
                                    </td>

                                    <td>
                                        <div>@asset.Brand</div>
                                        <small class="text-muted">
                                            @asset.Model
                                        </small>
                                    </td>

                                    <td>
                                        @asset.SerialNumber
                                    </td>

                                    <td>
                                        <span class="badge @GetStatusBadgeClass(asset.Status)">
                                            @GetStatusText(asset.Status)
                                        </span>
                                    </td>

                                    <td>
                                        @asset.AssignedTo
                                    </td>

                                    <td>
                                        @asset.DepartmentName
                                    </td>

                                    <td>
                                        @if (asset.RoomName != "—")
                                        {
                                            <div>@asset.RoomName</div>
                                        }
                                        else
                                        {
                                            <div>@asset.Location</div>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <a asp-controller="Assets"
                                           asp-action="Details"
                                           asp-route-id="@asset.AssetId"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>

@functions
{
    private static string GetStatusText(AssetStatus status)
{
    return status switch
    {
        AssetStatus.Available => "Available",
        AssetStatus.Assigned => "Assigned",
        AssetStatus.Maintenance => "Maintenance",
        AssetStatus.Lost => "Lost",
        AssetStatus.Disposed => "Disposed",
        _ => status.ToString()
    };
}

    private static string GetStatusBadgeClass(AssetStatus status)
{
    return status switch
    {
        AssetStatus.Available => "bg-success",
        AssetStatus.Assigned => "bg-primary",
        AssetStatus.Maintenance => "bg-warning text-dark",
        AssetStatus.Lost => "bg-dark",
        AssetStatus.Disposed => "bg-secondary",
        _ => "bg-secondary"
    };
}
}