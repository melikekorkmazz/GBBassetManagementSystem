@model GBBassetManagementSystem.Web.Models.InventoryCategoryDetailsViewModel

@using GBBassetManagementSystem.Entity.Enums
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<GBBassetManagementSystem.Web.SharedResource> Localizer

@{
    ViewData["Title"] =
        $"{Model.CategoryName} - {Localizer["Inventory"]}";
}

<div class="container-xxl flex-grow-1 container-p-y">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">

                    <li class="breadcrumb-item">
                        <a asp-controller="Inventory"
                           asp-action="Index">
                            @Localizer["Inventory"]
                        </a>
                    </li>

                    <li class="breadcrumb-item active"
                        aria-current="page">
                        @Model.CategoryName
                    </li>

                </ol>
            </nav>

            <h4 class="mb-0">
                @Model.CategoryName - @Localizer["Inventory"]
            </h4>

        </div>

        <a asp-controller="Inventory"
           asp-action="Index"
           class="btn btn-label-secondary">

            <i class="icon-base ti tabler-arrow-left me-1"></i>
            @Localizer["BackToInventory"]
        </a>

    </div>

    <!-- Summary -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-lg-2">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <h2 class="mb-1">@Model.Total</h2>
                    <span class="text-muted">
                        @Localizer["TotalAssets"]
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-2">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <h2 class="mb-1">@Model.Available</h2>
                    <span class="text-muted">
                        @Localizer["Available"]
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-2">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <h2 class="mb-1">@Model.Assigned</h2>
                    <span class="text-muted">
                        @Localizer["Assigned"]
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-2">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <h2 class="mb-1">@Model.Maintenance</h2>
                    <span class="text-muted">
                        @Localizer["Maintenance"]
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-2">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <h2 class="mb-1">@Model.Lost</h2>
                    <span class="text-muted">
                        @Localizer["Lost"]
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-2">
            <div class="card h-100 text-center">
                <div class="card-body">
                    <h2 class="mb-1">@Model.Disposed</h2>
                    <span class="text-muted">
                        @Localizer["Disposed"]
                    </span>
                </div>
            </div>
        </div>

    </div>

    <!-- Top assigned models -->
    <div class="card mb-4">

        <div class="card-header border-bottom">
            <h5 class="mb-0">
                <i class="icon-base ti tabler-trophy me-1"></i>
                @Localizer["TopAssignedModels"]
            </h5>
        </div>

        <div class="card-body">

            @if (!Model.TopAssignedModels.Any())
            {
                <p class="text-muted mb-0">
                    @Localizer["NoAssignmentHistoryFound"]
                </p>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>@Localizer["Brand"]</th>
                                <th>@Localizer["Model"]</th>
                                <th class="text-end">
                                    @Localizer["Assignments"]
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int rank = 1;
                            }

                            @foreach (var item in Model.TopAssignedModels)
                            {
                                <tr>

                                    <td>
                                        @(rank == 1 ? "🥇" :
                                          rank == 2 ? "🥈" :
                                          "🥉")
                                    </td>

                                    <td>@item.Brand</td>
                                    <td>@item.Model</td>

                                    <td class="text-end">
                                        @item.AssignmentCount
                                    </td>

                                </tr>

                                rank++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <!-- Distributions -->
    <div class="row g-4 mb-4">

        <!-- Departments -->
        <div class="col-lg-6">

            <div class="card h-100">

                <div class="card-header border-bottom">
                    <h5 class="mb-0">
                        @Localizer["DepartmentDistribution"]
                    </h5>
                </div>

                @if (Model.Departments.Count == 0)
                {
                    <div class="card-body text-center text-muted">
                        @Localizer["NoDepartmentAssignmentFound"]
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>@Localizer["Department"]</th>
                                    <th class="text-end">
                                        @Localizer["AssetCount"]
                                    </th>
                                    <th class="text-end">
                                        @Localizer["Percentage"]
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var department in Model.Departments)
                                {
                                    var percentage =
                                        Model.Total == 0
                                            ? 0
                                            : department.AssetCount * 100.0 / Model.Total;

                                    <tr>

                                        <td>
                                            <a asp-controller="Inventory"
                                               asp-action="CategoryDetails"
                                               asp-route-id="@Model.CategoryId"
                                               asp-route-departmentId="@department.DepartmentId"
                                               asp-route-status="@Model.SelectedStatus"
                                               asp-route-search="@Model.Search"
                                               class="text-decoration-none fw-semibold">

                                                @department.DepartmentName
                                            </a>
                                        </td>

                                        <td class="text-end">
                                            @department.AssetCount
                                        </td>

                                        <td class="text-end">
                                            @percentage.ToString("0.#")%
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

        <!-- Rooms -->
        <div class="col-lg-6">

            <div class="card h-100">

                <div class="card-header border-bottom">
                    <h5 class="mb-0">
                        @Localizer["RoomDistribution"]
                    </h5>
                </div>

                @if (Model.Rooms.Count == 0)
                {
                    <div class="card-body text-center text-muted">
                        @Localizer["NoRoomAssignmentFound"]
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th>@Localizer["Room"]</th>
                                    <th>@Localizer["Department"]</th>
                                    <th class="text-end">
                                        @Localizer["AssetCount"]
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var room in Model.Rooms)
                                {
                                    <tr>

                                        <td>
                                            <a asp-controller="Inventory"
                                               asp-action="CategoryDetails"
                                               asp-route-id="@Model.CategoryId"
                                               asp-route-roomId="@room.RoomId"
                                               asp-route-status="@Model.SelectedStatus"
                                               asp-route-search="@Model.Search"
                                               class="text-decoration-none fw-semibold">

                                                @room.RoomName
                                            </a>
                                        </td>

                                        <td>
                                            @room.DepartmentName
                                        </td>

                                        <td class="text-end">
                                            @room.AssetCount
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

    </div>

    <!-- Filters -->
    <div class="card mb-4">

        <div class="card-header border-bottom">
            <h5 class="mb-0">
                @Localizer["Filters"]
            </h5>
        </div>

        <div class="card-body">

            <form asp-controller="Inventory"
                  asp-action="CategoryDetails"
                  method="get">

                <input type="hidden"
                       name="id"
                       value="@Model.CategoryId" />

                <div class="row g-3 align-items-end">

                    <div class="col-md-6 col-lg-3">

                        <label for="search"
                               class="form-label">
                            @Localizer["Search"]
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="@Localizer["InventorySearchPlaceholder"]" />

                    </div>

                    <div class="col-md-6 col-lg-3">

                        <label for="status"
                               class="form-label">
                            @Localizer["Status"]
                        </label>

                        <select id="status"
                                name="status"
                                class="form-select">

                            <option value="">
                                @Localizer["AllStatuses"]
                            </option>

                            @foreach (var statusValue in Enum.GetValues<AssetStatus>())
                            {
                                if (Model.SelectedStatus == statusValue)
                                {
                                    <option value="@statusValue"
                                            selected>
                                        @GetStatusText(statusValue)
                                    </option>
                                }
                                else
                                {
                                    <option value="@statusValue">
                                        @GetStatusText(statusValue)
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-md-6 col-lg-3">

                        <label for="departmentId"
                               class="form-label">
                            @Localizer["Department"]
                        </label>

                        <select id="departmentId"
                                name="departmentId"
                                class="form-select">

                            <option value="">
                                @Localizer["AllDepartments"]
                            </option>

                            @foreach (var department in Model.Departments)
                            {
                                if (Model.SelectedDepartmentId ==
                                    department.DepartmentId)
                                {
                                    <option value="@department.DepartmentId"
                                            selected>
                                        @department.DepartmentName
                                    </option>
                                }
                                else
                                {
                                    <option value="@department.DepartmentId">
                                        @department.DepartmentName
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-md-6 col-lg-3">

                        <label for="roomId"
                               class="form-label">
                            @Localizer["Room"]
                        </label>

                        <select id="roomId"
                                name="roomId"
                                class="form-select">

                            <option value="">
                                @Localizer["AllRooms"]
                            </option>

                            @foreach (var room in Model.Rooms)
                            {
                                if (Model.SelectedRoomId == room.RoomId)
                                {
                                    <option value="@room.RoomId"
                                            selected>
                                        @room.RoomName
                                    </option>
                                }
                                else
                                {
                                    <option value="@room.RoomId">
                                        @room.RoomName
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-12 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="icon-base ti tabler-filter me-1"></i>
                            @Localizer["ApplyFilters"]
                        </button>

                        <a asp-controller="Inventory"
                           asp-action="CategoryDetails"
                           asp-route-id="@Model.CategoryId"
                           class="btn btn-label-secondary">

                            <i class="icon-base ti tabler-x me-1"></i>
                            @Localizer["ClearFilters"]
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Assets -->
    <div class="card">

        <div class="card-header border-bottom d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                @Localizer["Assets"]
            </h5>

            <span class="badge bg-label-secondary">
                @Model.Assets.Count @Localizer["Results"]
            </span>

        </div>

        @if (Model.Assets.Count == 0)
        {
            <div class="card-body text-center py-5">

                <div class="avatar avatar-xl mx-auto mb-3">
                    <span class="avatar-initial rounded-circle bg-label-secondary">
                        <i class="icon-base ti tabler-package-off fs-2"></i>
                    </span>
                </div>

                <h5>
                    @Localizer["NoAssetsFound"]
                </h5>

                <p class="text-muted mb-0">
                    @Localizer["NoAssetsMatchFilters"]
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover">

                    <thead class="table-light">
                        <tr>
                            <th>@Localizer["AssetCode"]</th>
                            <th>@Localizer["Asset"]</th>
                            <th>@Localizer["BrandModel"]</th>
                            <th>@Localizer["SerialNumber"]</th>
                            <th>@Localizer["Status"]</th>
                            <th>@Localizer["AssignedTo"]</th>
                            <th>@Localizer["Department"]</th>
                            <th>@Localizer["RoomLocation"]</th>
                            <th class="text-end">
                                @Localizer["Action"]
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var asset in Model.Assets)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @asset.AssetCode
                                </td>

                                <td>
                                    @asset.Name
                                </td>

                                <td>
                                    <div>@asset.Brand</div>

                                    <small class="text-muted">
                                        @asset.Model
                                    </small>
                                </td>

                                <td>
                                    @asset.SerialNumber
                                </td>

                                <td>
                                    <span class="badge @GetStatusBadgeClass(asset.Status)">
                                        @GetStatusText(asset.Status)
                                    </span>
                                </td>

                                <td>
                                    @asset.AssignedTo
                                </td>

                                <td>
                                    @asset.DepartmentName
                                </td>

                                <td>
                                    @if (asset.RoomName != "—")
                                    {
                                        @asset.RoomName
                                    }
                                    else
                                    {
                                        @asset.Location
                                    }
                                </td>

                                <td class="text-end">

                                    <a asp-controller="Assets"
                                       asp-action="Details"
                                       asp-route-id="@asset.AssetId"
                                       class="btn btn-sm btn-label-info">

                                        <i class="icon-base ti tabler-eye me-1"></i>
                                        @Localizer["Details"]
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

@functions
{
    private string GetStatusText(AssetStatus status)
    {
        return status switch
        {
            AssetStatus.Available =>
                Localizer["Available"].Value,

            AssetStatus.Assigned =>
                Localizer["Assigned"].Value,

            AssetStatus.Maintenance =>
                Localizer["Maintenance"].Value,

            AssetStatus.Lost =>
                Localizer["Lost"].Value,

            AssetStatus.Disposed =>
                Localizer["Disposed"].Value,

            _ => status.ToString()
        };
    }

    private static string GetStatusBadgeClass(
        AssetStatus status)
    {
        return status switch
        {
            AssetStatus.Available =>
                "bg-label-success",

            AssetStatus.Assigned =>
                "bg-label-primary",

            AssetStatus.Maintenance =>
                "bg-label-warning",

            AssetStatus.Lost =>
                "bg-label-dark",

            AssetStatus.Disposed =>
                "bg-label-danger",

            _ =>
                "bg-label-secondary"
        };
    }
}