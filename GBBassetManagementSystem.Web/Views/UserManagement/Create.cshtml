@model GBBassetManagementSystem.Web.Models.CreateUserViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GBBassetManagementSystem.Web.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["CreateNewDepartmentUser"];
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">

            <div class="card">

                <div class="card-header border-bottom">

                    <div class="d-flex align-items-center gap-3">

                        <div class="avatar">
                            <span class="avatar-initial rounded bg-label-primary">
                                <i class="icon-base ti tabler-user-plus"></i>
                            </span>
                        </div>

                        <div>
                            <h4 class="mb-1">
                                @Localizer["CreateNewDepartmentUser"]
                            </h4>

                            <p class="text-muted mb-0">
                                @Localizer["CreateDepartmentUserDescription"]
                            </p>
                        </div>

                    </div>

                </div>

                <div class="card-body pt-4">

                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success alert-dismissible fade show"
                             role="alert">

                            <i class="icon-base ti tabler-circle-check me-2"></i>
                            @successMessage

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close">
                            </button>

                        </div>
                    }

                    <form asp-controller="UserManagement"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger"
                                 role="alert">
                            </div>
                        }

                        <div class="mb-3">

                            <label asp-for="DepartmentId"
                                   class="form-label">

                                @Localizer["Department"]
                            </label>

                            <select asp-for="DepartmentId"
                                    asp-items="Model.Departments"
                                    class="form-select">

                                <option value="">
                                    @Localizer["SelectDepartment"]
                                </option>

                            </select>

                            <span asp-validation-for="DepartmentId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="FirstName"
                                       class="form-label">

                                    @Localizer["FirstName"]
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control"
                                       autocomplete="given-name" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="LastName"
                                       class="form-label">

                                    @Localizer["LastName"]
                                </label>

                                <input asp-for="LastName"
                                       class="form-control"
                                       autocomplete="family-name" />

                                <span asp-validation-for="LastName"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="UserName"
                                   class="form-label">

                                @Localizer["Username"]
                            </label>

                            <input asp-for="UserName"
                                   class="form-control"
                                   autocomplete="username" />

                            <span asp-validation-for="UserName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">

                                @Localizer["Email"]
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   type="email"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-2">

                            <label asp-for="Password"
                                   class="form-label">

                                @Localizer["Password"]
                            </label>

                            <div class="input-group input-group-merge">

                                <input asp-for="Password"
                                       class="form-control"
                                       type="password"
                                       id="Password"
                                       autocomplete="new-password" />

                                <button type="button"
                                        class="input-group-text"
                                        onclick="togglePassword('Password', this)"
                                        title="@Localizer["ShowPassword"]">

                                    <i class="icon-base ti tabler-eye-off"></i>
                                </button>

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="alert alert-info py-2 mb-3"
                             role="alert">

                            <small>
                                <i class="icon-base ti tabler-info-circle me-1"></i>
                                @Localizer["PasswordRequirements"]
                            </small>

                        </div>

                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label">

                                @Localizer["ConfirmPassword"]
                            </label>

                            <div class="input-group input-group-merge">

                                <input asp-for="ConfirmPassword"
                                       class="form-control"
                                       type="password"
                                       id="ConfirmPassword"
                                       autocomplete="new-password" />

                                <button type="button"
                                        class="input-group-text"
                                        onclick="togglePassword('ConfirmPassword', this)"
                                        title="@Localizer["ShowPassword"]">

                                    <i class="icon-base ti tabler-eye-off"></i>
                                </button>

                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="UserManagement"
                               asp-action="Index"
                               class="btn btn-label-secondary">

                                <i class="icon-base ti tabler-x me-1"></i>
                                @Localizer["Cancel"]
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="icon-base ti tabler-user-plus me-1"></i>
                                @Localizer["CreateUser"]
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(inputId, button) {
            const input =
                document.getElementById(inputId);

            const icon =
                button.querySelector("i");

            if (!input || !icon) {
                return;
            }

            const passwordIsHidden =
                input.type === "password";

            input.type =
                passwordIsHidden ? "text" : "password";

            if (passwordIsHidden) {
                icon.classList.remove("tabler-eye-off");
                icon.classList.add("tabler-eye");

                button.title =
                    '@Localizer["HidePassword"]';
            } else {
                icon.classList.remove("tabler-eye");
                icon.classList.add("tabler-eye-off");

                button.title =
                    '@Localizer["ShowPassword"]';
            }
        }
    </script>
}