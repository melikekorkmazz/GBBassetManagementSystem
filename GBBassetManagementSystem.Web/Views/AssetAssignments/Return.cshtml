@model GBBassetManagementSystem.Web.Models.ReturnAssetViewModel

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<GBBassetManagementSystem.Web.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["ReturnAsset"];
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">

            <div class="card">

                <div class="card-header border-bottom">

                    <div class="d-flex align-items-center gap-3">

                        <div class="avatar">
                            <span class="avatar-initial rounded bg-label-success">
                                <i class="icon-base ti tabler-arrow-back-up"></i>
                            </span>
                        </div>

                        <div>

                            <h4 class="mb-1">
                                @Localizer["ReturnAsset"]
                            </h4>

                            <p class="text-muted mb-0">
                                @Localizer["ReturnAssetDescription"]
                            </p>

                        </div>

                    </div>

                </div>

                <div class="card-body pt-4">

                    <div class="alert alert-info"
                         role="alert">

                        <div class="mb-2">

                            <strong>
                                <i class="icon-base ti tabler-device-desktop me-1"></i>
                                @Localizer["Asset"]:
                            </strong>

                            <span>
                                @Model.AssetDisplayName
                            </span>

                        </div>

                        <div>

                            <strong>
                                <i class="icon-base ti tabler-user me-1"></i>
                                @Localizer["AssignedTo"]:
                            </strong>

                            <span>
                                @Model.AssignedTo
                            </span>

                        </div>

                    </div>

                    <form asp-controller="AssetAssignments"
                          asp-action="Return"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="AssignmentId"
                               type="hidden" />

                        <input asp-for="AssetDisplayName"
                               type="hidden" />

                        <input asp-for="AssignedTo"
                               type="hidden" />

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All"
                                 class="alert alert-danger"
                                 role="alert">
                            </div>
                        }

                        <div class="mb-3">

                            <label asp-for="ReturnDate"
                                   class="form-label">

                                @Localizer["ReturnDate"]
                            </label>

                            <input asp-for="ReturnDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="ReturnDate"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="ReceivedBy"
                                   class="form-label">

                                @Localizer["ReceivedBy"]
                            </label>

                            <input asp-for="ReceivedBy"
                                   class="form-control"
                                   placeholder="@Localizer["ReturnReceivedByPlaceholder"]" />

                            <span asp-validation-for="ReceivedBy"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Condition"
                                   class="form-label">

                                @Localizer["Condition"]
                            </label>

                            <select asp-for="Condition"
                                    id="conditionSelect"
                                    class="form-select">

                                <option value="Good">
                                    @Localizer["Good"]
                                </option>

                                <option value="Damaged">
                                    @Localizer["Damaged"]
                                </option>

                                <option value="MissingParts">
                                    @Localizer["MissingParts"]
                                </option>

                            </select>

                            <span asp-validation-for="Condition"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3"
                             id="damageDescriptionSection">

                            <label asp-for="DamageDescription"
                                   class="form-label">

                                @Localizer["DamageDescription"]
                            </label>

                            <textarea asp-for="DamageDescription"
                                      rows="3"
                                      class="form-control"
                                      placeholder="@Localizer["DamageDescriptionPlaceholder"]"></textarea>

                            <span asp-validation-for="DamageDescription"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Notes"
                                   class="form-label">

                                @Localizer["Notes"]
                            </label>

                            <textarea asp-for="Notes"
                                      rows="3"
                                      class="form-control"
                                      placeholder="@Localizer["ReturnNotesPlaceholder"]"></textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="alert alert-warning"
                             role="alert">

                            <i class="icon-base ti tabler-alert-triangle me-1"></i>
                            @Localizer["ReturnAssetWarning"]
                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="AssetAssignments"
                               asp-action="Index"
                               class="btn btn-label-secondary">

                                <i class="icon-base ti tabler-x me-1"></i>
                                @Localizer["Cancel"]
                            </a>

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="icon-base ti tabler-check me-1"></i>
                                @Localizer["ConfirmReturn"]
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const conditionSelect =
                document.getElementById("conditionSelect");

            const damageDescriptionSection =
                document.getElementById("damageDescriptionSection");

            function updateDamageDescriptionVisibility() {

                const condition =
                    conditionSelect.value;

                const damageInformationRequired =
                    condition === "Damaged" ||
                    condition === "MissingParts";

                damageDescriptionSection.style.display =
                    damageInformationRequired ? "block" : "none";
            }

            conditionSelect.addEventListener(
                "change",
                updateDamageDescriptionVisibility);

            updateDamageDescriptionVisibility();
        });
    </script>
}