@model IEnumerable<GBBassetManagementSystem.Entity.Entities.AssetAssignment>

@{
    ViewData["Title"] = "Asset Assignments";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Asset Assignments</h1>

    <a asp-action="Create" class="btn btn-primary">
        New Assignment
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No assignments have been created yet.
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Asset</th>
                <th>Assignment Type</th>
                <th>Assigned To</th>
                <th>Department</th>
                <th>Assignment Date</th>
                <th>Expected Return</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var assignment in Model)
            {
                <tr>
                    <td>
                        @assignment.Asset?.AssetCode -
                        @assignment.Asset?.Name
                    </td>

                    <td>@assignment.AssignmentType</td>

                    <td>
                        @if (assignment.AssignmentType ==
                            GBBassetManagementSystem.Entity.Enums.AssignmentType.Personnel)
                        {
                            <span>
                                @assignment.Personnel?.FirstName
                                @assignment.Personnel?.LastName
                            </span>
                        }
                        else
                        {
                            <span>
                                @assignment.Room?.Name
                                (@assignment.Room?.RoomNumber)
                            </span>
                        }
                    </td>

                    <td>
                        @if (assignment.Personnel is not null)
                        {
                            @assignment.Personnel.Department?.Name
                        }
                        else
                        {
                            @assignment.Room?.Department?.Name
                        }
                    </td>

                    <td>
                        @assignment.AssignmentDate.ToString("dd.MM.yyyy")
                    </td>

                    <td>
                        @assignment.ExpectedReturnDate?.ToString("dd.MM.yyyy")
                    </td>

                    <td>
                        @if (assignment.IsActive)
                        {
                            <span class="badge bg-success">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Returned
                            </span>
                        }
                    </td>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@assignment.Id"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        @if (assignment.IsActive)
                        {
                            <a asp-action="Return"
                               asp-route-id="@assignment.Id"
                               class="btn btn-success btn-sm">
                                Return
                            </a>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Returned
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}