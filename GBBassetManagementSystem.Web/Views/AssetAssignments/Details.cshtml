@model GBBassetManagementSystem.Entity.Entities.AssetAssignment

@using GBBassetManagementSystem.Entity.Enums

@{
    ViewData["Title"] = "Assignment Details";
}

<h1>Assignment Details</h1>

<hr />

<dl class="row">
    <dt class="col-sm-3">Asset</dt>
    <dd class="col-sm-9">
        @Model.Asset?.AssetCode - @Model.Asset?.Name
    </dd>

    <dt class="col-sm-3">Assignment Type</dt>
    <dd class="col-sm-9">
        @Model.AssignmentType
    </dd>

    <dt class="col-sm-3">Assigned To</dt>
    <dd class="col-sm-9">
        @if (Model.AssignmentType == AssignmentType.Personnel)
        {
            @($"{Model.Personnel?.FirstName} {Model.Personnel?.LastName}")
        }
        else
        {
            @($"{Model.Room?.Name} ({Model.Room?.RoomNumber})")
        }
    </dd>

    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">
        @if (Model.Personnel != null)
        {
            @(Model.Personnel.Department?.Name ?? "-")
        }
        else if (Model.Room != null)
        {
            @(Model.Room.Department?.Name ?? "-")
        }
        else
        {
            <span>-</span>
        }
    </dd>

    <dt class="col-sm-3">Delivered By</dt>
    <dd class="col-sm-9">
        @Model.DeliveredBy
    </dd>

    <dt class="col-sm-3">Received By</dt>
    <dd class="col-sm-9">
        @Model.ReceivedBy
    </dd>

    <dt class="col-sm-3">Assignment Date</dt>
    <dd class="col-sm-9">
        @Model.AssignmentDate.ToString("dd.MM.yyyy")
    </dd>

    <dt class="col-sm-3">Expected Return</dt>
    <dd class="col-sm-9">
        @Model.ExpectedReturnDate?.ToString("dd.MM.yyyy")
    </dd>

    <dt class="col-sm-3">Return Date</dt>
    <dd class="col-sm-9">
        @Model.ReturnDate?.ToString("dd.MM.yyyy")
    </dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @(Model.IsActive ? "Active" : "Returned")
    </dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">
        @Model.Notes
    </dd>
</dl>

@if (Model.IsActive)
{
    <a asp-action="Return"
       asp-route-id="@Model.Id"
       class="btn btn-success">
        Return Asset
    </a>
}

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>