@model GBBassetManagementSystem.Entity.Entities.AssetAssignment

@{
    ViewData["Title"] = "New Asset Assignment";
}

<h1>New Asset Assignment</h1>

<hr />

<div class="row">
    <div class="col-md-7">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="All"
                 class="text-danger">
            </div>

            <div class="mb-3">
                <label asp-for="AssetId"
                       class="form-label">
                    Asset
                </label>

                <select asp-for="AssetId"
                        asp-items="ViewBag.Assets"
                        class="form-select">
                    <option value="">Select Asset</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="AssignmentType"
                       class="form-label">
                    Assignment Type
                </label>

                <select asp-for="AssignmentType"
                        id="assignmentType"
                        class="form-select">
                    <option value="1">Personnel</option>
                    <option value="2">Room</option>
                </select>
            </div>

            <div class="mb-3"
     id="departmentSection">

    <label class="form-label">
        Department
    </label>

    <select id="departmentSelect"
            class="form-select"
            asp-items="ViewBag.Departments">

        <option value="">Select Department</option>

    </select>

</div>

            <div class="mb-3"
                 id="personnelSection">

                <label asp-for="PersonnelId"
                       class="form-label">
                    Personnel
                </label>

                <select asp-for="PersonnelId"
                  id="personnelSelect"
                asp-items="ViewBag.Personnel"
               class="form-select">
                    <option value="">Select Personnel</option>
                </select>
            </div>

            <div class="mb-3"
                 id="roomSection"
                 style="display:none;">

                <label asp-for="RoomId"
                       class="form-label">
                    Room
                </label>

                  <select asp-for="RoomId"
                 id="roomSelect"
                asp-items="ViewBag.Rooms"
                 class="form-select">
                <option value="">Select Room</option>
                 </select>
            </div>

            <div class="mb-3">
                <label asp-for="DeliveredBy"
                       class="form-label"></label>

                <input asp-for="DeliveredBy"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ReceivedBy"
                       class="form-label"></label>

                <input asp-for="ReceivedBy"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="AssignmentDate"
                       class="form-label"></label>

                <input asp-for="AssignmentDate"
                       type="date"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ExpectedReturnDate"
                       class="form-label"></label>

                <input asp-for="ExpectedReturnDate"
                       type="date"
                       class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Notes"
                       class="form-label"></label>

                <textarea asp-for="Notes"
                          rows="4"
                          class="form-control"></textarea>
            </div>

            <button type="submit"
                    class="btn btn-success">
                Assign
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </form>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const assignmentType =
                document.getElementById("assignmentType");

            const personnelSection =
                document.getElementById("personnelSection");

            const roomSection =
                document.getElementById("roomSection");

            const departmentSelect =
                document.getElementById("departmentSelect");

            const personnelSelect =
                document.getElementById("personnelSelect");

            const roomSelect =
                document.getElementById("roomSelect");

            function updateAssignmentFields() {

                if (assignmentType.value === "2") {

                    personnelSection.style.display = "none";
                    roomSection.style.display = "block";

                    personnelSelect.value = "";

                } else {

                    personnelSection.style.display = "block";
                    roomSection.style.display = "none";

                    roomSelect.value = "";
                }
            }

            assignmentType.addEventListener(
                "change",
                updateAssignmentFields);

            departmentSelect.addEventListener(
                "change",
                async function () {

                    const departmentId = this.value;

                    personnelSelect.innerHTML =
                        '<option value="">Select Personnel</option>';

                    roomSelect.innerHTML =
                        '<option value="">Select Room</option>';

                    if (departmentId === "") {
                        return;
                    }

                    try {
                        const personnelResponse = await fetch(
                            `/AssetAssignments/GetPersonnelByDepartment?departmentId=${departmentId}`
                        );

                        if (!personnelResponse.ok) {
                            throw new Error(
                                "Personnel could not be loaded.");
                        }

                        const personnel =
                            await personnelResponse.json();

                        personnel.forEach(person => {
                            const option =
                                document.createElement("option");

                            option.value = person.id;
                            option.textContent = person.fullName;

                            personnelSelect.appendChild(option);
                        });

                        const roomResponse = await fetch(
                            `/AssetAssignments/GetRoomsByDepartment?departmentId=${departmentId}`
                        );

                        if (!roomResponse.ok) {
                            throw new Error(
                                "Rooms could not be loaded.");
                        }

                        const rooms =
                            await roomResponse.json();

                        rooms.forEach(room => {
                            const option =
                                document.createElement("option");

                            option.value = room.id;
                            option.textContent = room.name;

                            roomSelect.appendChild(option);
                        });

                    } catch (error) {
                        console.error(error);
                    }
                });

            updateAssignmentFields();
        });
    </script>
}